# Attesta — variables de entorno
# Copia este archivo a `.env.local` y rellena con los valores de tu proyecto Supabase.
# Sin estas variables, la app funciona en MODO DEMO con datos de ejemplo.

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor. NUNCA lo expongas en el cliente ni lo subas al repo.
# (Se usa para tareas administrativas puntuales; opcional para el MVP.)
SUPABASE_SERVICE_ROLE_KEY=

# --- Foso automatizado (Capa 7) — solo servidor, opcional ---
# Secreto compartido para el cron del Vigía/Analista (Vercel Cron → Bearer).
CRON_SECRET=

# Fase B — el Analista (RAG). Sin estas llaves, el Analista degrada a fallback
# (no enriquece) y el resto de la app funciona igual.
# Embeddings (https://www.voyageai.com → API Keys; 200M tokens gratis)
VOYAGE_API_KEY=
# Drafting del Analista — endpoint compatible con OpenAI (function calling).
# Por defecto NVIDIA NIM (gratis, https://build.nvidia.com → API key `nvapi-...`).
# Alternativas: Groq (https://console.groq.com), OpenRouter, etc.
ANALISTA_API_KEY=
# Opcionales (tienen default a NVIDIA NIM + Llama 3.3 70B):
# ANALISTA_BASE_URL=https://integrate.api.nvidia.com/v1
# ANALISTA_MODEL=meta/llama-3.3-70b-instruct

# --- Pagos (Stripe) — opcional, env-gated (sin llaves, la facturación se apaga) ---
# Solo servidor:
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Cliente (llegan al navegador — no son secretas):
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Precio a mostrar en la UI (p. ej. "49"); solo texto, no cobra nada.
NEXT_PUBLIC_PLAN_PRICE=

# --- Correo (Resend) — opcional; sin RESEND_API_KEY, waitlist y digest no envían ---
RESEND_API_KEY=
# Remitente (por defecto onboarding@resend.dev; usa tu dominio verificado en Resend).
RESEND_FROM=
# Dónde recibir los avisos de nuevas solicitudes de la waitlist.
FOUNDER_NOTIFY_EMAIL=

# --- SSO / acceso corporativo — opcional; "1" muestra el botón (config en Supabase Auth) ---
NEXT_PUBLIC_SSO_GOOGLE=
NEXT_PUBLIC_SSO_MICROSOFT=

# --- Identidad legal (páginas de privacidad, DPA y subprocesadores) ---
# Sin estos cuatro datos, las páginas legales se sirven marcadas como BORRADOR,
# con un aviso visible y `noindex`, y no entran en el sitemap. NO se inventa
# ningún valor por defecto: un aviso de privacidad que parece terminado y nombra
# a una sociedad que no existe es peor que no tener ninguno.
# El quinto es opcional y solo aplica si el responsable NO está establecido en la
# UE pero ofrece servicios a personas en la UE (art. 27 RGPD).
LEGAL_ENTITY_NAME=
LEGAL_ENTITY_ADDRESS=
LEGAL_ENTITY_TAX_ID=
LEGAL_PRIVACY_EMAIL=
LEGAL_EU_REPRESENTATIVE=

# --- App ---
# Dominio público completo, sin barra final y sin ruta (p. ej. https://attesta.io).
# OBLIGATORIA en Vercel: de ella salen canonical, hreflang, sitemap, robots y los
# enlaces de los correos. Si falta en un despliegue, el build FALLA a propósito
# (`src/lib/site-url.ts`): antes se caía a un dominio por defecto y los enlaces
# salían mal sin que nada se quejara. En local no hace falta: se usa localhost.
NEXT_PUBLIC_APP_URL=
